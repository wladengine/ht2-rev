static void townFields() {
    // Independent TNDE layout: index already consumed, 28 field bytes,
    // 8 ignored bytes, 4-byte alternate cargo; next chunk must not be read.
    DWORD input[12]={25,0xffffffff,5,0x1234,0x5678,0x9abc,0xdef0,111,222,7,0x45444e54,44};
    DWORD node[8]={}; BYTE* cursor=(BYTE*)input; BYTE** cur=&cursor;
// TOWN_FIELDS
    check(node[0]==25 && node[1]==0xffffffff && node[3]==5,"town ordinary fields");
    check(node[2]==7 && cursor==(BYTE*)input+40,"town alternate cargo and cursor boundary");
    check(node[4]==0x1234 && node[7]==0xdef0,"town double fields");
}
