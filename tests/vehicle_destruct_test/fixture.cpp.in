static BYTE g_vd6d24e0[8],g_vd6d24bc[32],*g_vd6ef204;
static BYTE* g_vd6ef1fc=world;
static int g_vd6ef1f0;
static char s_vd679f54;
static char room[]="room_aq_008", model[]="fixture_model", module[]="aq";
static int expected, observed, calls, binds, returned, bases, callbacks, failed;
static void check(bool ok,const char* label) { if(!ok){printf("FAIL %s\n",label);failed++;} }
static BYTE* Car_InList(void*) { return 0; }
