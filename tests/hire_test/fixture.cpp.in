struct Matrix { float m[12]; };
struct Vec3 { float x,y,z; };
struct Bc_M48 { DWORD d[12]; };
static BYTE shell[1400], viewer[624], parkingUI[40], parkingInfo[256], world[800];
static BYTE me[22000], other[22000], myCab[10200], otherCab[10200];
static BYTE player[1024], candidate[1024], resource[8], iterator[12], owner[16];
static BYTE* g_wsShell=shell;
static BYTE* g_bc6d2078=viewer;
static BYTE* g_bc6f3434=parkingUI;
static BYTE* g_bc6f2d98=parkingInfo;
static BYTE* g_bc6f68b0=owner;
static Matrix identity={{1,0,0,0,1,0,0,0,1,0,0,0}};
static BYTE* g_bc7025f0=(BYTE*)&identity;
static int g_bc68b990=0, g_bc6f2dc0=0, g_bc6f33f4;
static float g_bc64c32c=50;
static bool present;
static BYTE* nearby;
static int flags, parkingResult, hireResult, swapResult, hireCalls, swapCalls, dataCalls, effects;
static BYTE *hireA,*hireB,*swapA,*swapB;
static void require(bool ok,const char* reason) {
    if(!ok) { fprintf(stderr,"fixture dependency violation: %s\n",reason);exit(2); }
}
static int* Int_Copy(int* out,void*,const int* p) { *out=*p;return out; }
static int Bc_Flags(int id) { require(id==(int)candidate,"candidate ID");return flags; }
static BYTE* Obj541970_First(BYTE* car,void*) { require(car==me,"iterator owner");return present?iterator:0; }
static BYTE* FUN_541960(BYTE*,void*) { return nearby; }
static BYTE* FUN_57de90(BYTE* object,void*,BYTE* out) {
    require(object==other+16,"candidate transform");
    memcpy(out,other+500,48);return out;
}
static Matrix* SceneObj_Matrix1(BYTE* object,void*,Matrix* out) {
    require(object==me+16,"player transform");memcpy(out,me+500,48);return out;
}
template<class R,class Fn,class... A> R CallThis(Fn fn,BYTE* s,A... args) { return fn(s,0,args...); }
template<class Fn,class... A> void CallC(Fn fn,A... args) { fn(args...); }
static void* Resources_Get(BYTE** table,void*,int key) {
    require((BYTE*)table==world+704 && key==123,"resource lookup");return resource;
}
static double Vec3_Length(const Vec3* v) { return sqrt(v->x*v->x+v->y*v->y+v->z*v->z); }
static int Ai_GetParkingInfo(BYTE* p,BYTE* out) {
    require(p==candidate && out==parkingInfo,"parking candidate");return parkingResult;
}
static void Player_CarId(int* out) { *out=(int)player; }
static void Ai_GetPlayerData(BYTE* p,BYTE* out) {
    require(p==candidate,"player data candidate");++dataCalls;memset(out,0,192);F(int,out,36)=777;
}
static int Player_Hire(BYTE* a,BYTE* b) {
    ++hireCalls;hireA=a;hireB=b;
    // Independent documented contract: the real implementation rejects self-hire.
    return a==b?-5:hireResult;
}
static int Player_SwapVehicles(BYTE* a,BYTE* b,int v) {
    require(v==0,"swap mode");++swapCalls;swapA=a;swapB=b;return swapResult;
}
static void Fx_PlaceObjects() { ++effects; }
static void World_ClearHits() { ++effects; }
static void Vehicle_FindTaker(BYTE*,void*) { ++effects; }
static void FUN_56fae0(int a,int b,int c,int d,Bc_M48) {
