}
static void Viewer_AttachVehicle(BYTE* v,void*,BYTE* c) { require(v==viewer && c==other,"viewer attach");++effects; }
static void WorldObj_Attach(BYTE*,void*,BYTE* c) { require(c==other,"object attach");++effects; }
static void Engine_SetKeys(BYTE* cab,void*,int a,int b) { require(cab==myCab+9984 && a==1 && b==1,"cab controls");++effects; }

// PRODUCTION

static void Reset() {
    memset(shell,0,sizeof shell);memset(viewer,0,sizeof viewer);
    memset(me,0,sizeof me);memset(other,0,sizeof other);
    memset(iterator,0,sizeof iterator);memset(parkingUI,0,sizeof parkingUI);
    memset(myCab,0,sizeof myCab);memset(otherCab,0,sizeof otherCab);
    F(BYTE*,shell,1356)=world;F(BYTE*,viewer,616)=me;
    F(int,other,20636)=(int)candidate;F(int,candidate,84)=123;F(int,resource,4)=456;
    F(BYTE*,me,21600)=myCab;F(BYTE*,other,21600)=otherCab;
    memcpy(me+500,&identity,48);memcpy(other+500,&identity,48);F(float,other,536)=10;
    nearby=other;present=true;g_bc6f33f4=1;flags=0x400;
    parkingResult=hireResult=swapResult=hireCalls=swapCalls=dataCalls=effects=0;
    hireA=hireB=swapA=swapB=0;
}
static int Run(int test) {
    Reset();const char* name="hire-success";int wantHire=0,wantSwap=0,wantEffects=0;
    switch(test) {
    case 0:wantHire=1;break;
    case 1:name="hire-refusal";wantHire=1;hireResult=-6;break;
    case 2:name="card-without-action";g_bc6f33f4=0;break;
    case 3:name="parking-refusal";parkingResult=1;break;
    case 4:name="multiplayer";F(int,shell,1300)=2;break;
    case 5:name="blocked-shell";F(int,shell,1316)=1;break;
    case 6:name="empty-list";present=false;break;
    case 7:name="no-driver";F(int,other,20636)=0;break;
    case 8:name="own-car";nearby=me;break;
    case 9:name="hidden";flags|=0x100;break;
    case 10:name="ordinary-driver";flags=0;break;
    case 11:name="range-boundary";F(float,other,536)=50;break;
    case 12:name="swap-success";flags=64;wantSwap=1;wantEffects=6;break;
    case 13:name="swap-refusal";flags=64;swapResult=-1;wantSwap=1;wantEffects=2;break;
    case 14:name="swap-precedence";flags=64|0x400;wantSwap=1;wantEffects=6;break;
    }
    Copter_BoardNearby();
    bool bad=hireCalls!=wantHire || swapCalls!=wantSwap || effects!=wantEffects;
    if(wantHire) {
        bad |= hireA!=player || hireB!=candidate || g_bc6f33f4!=0 || dataCalls!=1;
        // Old source may have no telemetry: still fail on its incorrect arguments.
        Copter_BoardNearby();bad |= hireCalls!=1; // consume request once
    }
    if(wantSwap) bad |= swapA!=player || swapB!=candidate || g_bc6f33f4!=0;
    if(wantSwap && !swapResult) bad |= F(int,other,20636)!=(int)player || F(int,me,20636)!=g_bc6f2dc0;
    printf("%s: hire=%d swap=%d correct_hirer=%d %s\n",name,hireCalls,swapCalls,hireA==player,bad?"FAIL":"PASS");
    return bad;
}
int main() {
    static_assert(sizeof(void*)==4,"x86 fixture required");
    int failures=0;for(int i=0;i<15;i++)failures+=Run(i);
    printf("%d failures in 15 cases\n",failures);return failures?1:0;
}
